# Скопируйте этот файл в .env и подставьте свои значения.
# Файл .env нельзя коммитить в GitHub! В .env.example секретов нет.

# Откуда брать данные:
#   live — открытые источники без ключей (OpenStreetMap, Wikipedia, Open-Meteo)
#          и сервис поиска travel-search-ru (Aviasales, Tutu.ru, Level.Travel,
#          Travelata, Trip.com); где данных нет — помеченные оценки.
# Другие значения не включают вымышленные данные: приложение сообщает
# об этом и продолжает работать на live.
DATA_PROVIDER=live

# Сервис поиска travel-search-ru: кэш авиабилетов, поездов и отелей без ключа.
# Это сторонний открытый проект MissiaL (MIT), не код OneTrip.
# 1 — включён (по умолчанию), 0 — выключен: останутся Travelpayouts и оценки.
TRAVEL_SEARCH=1

# Запасной источник кэшированных цен (если travel-search-ru недоступен).
# Бесплатный партнёрский токен Travelpayouts (кэш цен Aviasales/Hotellook).
# Регистрация: https://www.travelpayouts.com/  → раздел API.
# Без токена приложение работает: транспорт и отели берутся из travel-search-ru
# или считаются как оценка проекта.
# Не коммитьте токен в GitHub!
TRAVELPAYOUTS_TOKEN=

# --- Языковая модель: бесплатный облачный вариант ---
# Подойдёт любой OpenAI-совместимый API. Без модели приложение работает
# по правилам, но надёжно понимает только города из словаря.
#
# Вариант 1 (рекомендуется): Google AI Studio, бесплатный тариф Gemini.
#   Ключ: https://aistudio.google.com/apikey
#   Проверенная быстрая модель (ответ ~1-2 с): gemini-3.5-flash-lite.
#   Google периодически снимает старые модели с поддержки, поэтому если
#   сервис отвечает 404, возьмите актуальное имя Flash/Lite-модели
#   на https://ai.google.dev/gemini-api/docs/models
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_API_KEY=ваш-ключ
#
# Вариант 2: Groq, бесплатный тариф.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=имя-модели-из-консоли-Groq
# LLM_API_KEY=ваш-ключ
#
# Вариант 3: OpenRouter, модели с пометкой :free.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=имя-модели:free
# LLM_API_KEY=ваш-ключ
#
# Для локальной модели ключ можно оставить пустым
# (например, Ollama: http://localhost:11434/v1).
# Для облачного сервиса ключ обязателен.

LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60

# Ключи реальных API (понадобятся только при подключении реальных данных)
FLIGHTS_API_KEY=
HOTELS_API_KEY=
PLACES_API_KEY=
WEATHER_API_KEY=
